<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to the cloud backup (Google Drive). A direct
     transfer to a new phone, which never leaves the devices, keeps working.
     Earlier versions follow allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
